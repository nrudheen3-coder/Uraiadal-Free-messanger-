# Uraiadal Environment Variables
# Copy this to .env.local and fill in your values
# DO NOT commit .env.local to git

# Cloudflare Workers relay WebSocket URL
VITE_RELAY_URL=wss://relay.uraiadal.workers.dev

# Cloudflare Workers registry API URL
VITE_REGISTRY_URL=https://api.uraiadal.workers.dev

# App version
VITE_APP_VERSION=1.0.0
